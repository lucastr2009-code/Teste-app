  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #05070b;
      --card: #0b0f17;
      --cyan: #00e5ff;
      --cyan-dark: #00b8d4;
      --blue: #2979ff;
      --text: #e8f4ff;
      --muted: #8aa0b8;
      --border: rgba(0, 229, 255, 0.25);
      --glow: 0 0 20px rgba(0, 229, 255, 0.35);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100dvh;
      overflow-x: hidden;
    }

    /* ===== SIDEBAR ===== */
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      width: 260px;
      height: 100%;
      background: linear-gradient(180deg, #0a0e16 0%, #05070b 100%);
      border-right: 1px solid var(--border);
      z-index: 1000;
      transform: translateX(-100%);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      flex-direction: column;
      padding: 20px 0;
    }

    .sidebar.open {
      transform: translateX(0);
    }

    .sidebar-header {
      padding: 0 20px 24px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 16px;
    }

    .sidebar-logo {
      font-family: 'Orbitron', sans-serif;
      font-weight: 900;
      font-size: 1.15rem;
      letter-spacing: 1px;
      color: var(--cyan);
      text-shadow: var(--glow);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .sidebar-logo span {
      color: #fff;
    }

    .sidebar-sub {
      font-size: 0.7rem;
      color: var(--muted);
      margin-top: 4px;
      letter-spacing: 0.5px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 20px;
      color: var(--muted);
      font-weight: 500;
      font-size: 0.95rem;
      cursor: pointer;
      transition: all 0.2s;
      border-left: 3px solid transparent;
      user-select: none;
    }

    .nav-item:hover {
      background: rgba(0, 229, 255, 0.06);
      color: var(--text);
    }

    .nav-item.active {
      background: rgba(0, 229, 255, 0.12);
      color: var(--cyan);
      border-left-color: var(--cyan);
    }

    .nav-item svg {
      width: 22px;
      height: 22px;
      flex-shrink: 0;
    }

    .sidebar-footer {
      margin-top: auto;
      padding: 20px;
      border-top: 1px solid var(--border);
      text-align: center;
    }

    .sidebar-footer a {
      color: var(--cyan);
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 600;
    }

    /* ===== OVERLAY ===== */
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      z-index: 900;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s;
    }

    .overlay.show {
      opacity: 1;
      pointer-events: auto;
    }

    /* ===== MAIN ===== */
    .main {
      min-height: 100dvh;
      padding-bottom: 40px;
    }

    /* Top bar */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 16px;
      background: rgba(5, 7, 11, 0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }

    .menu-btn {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      background: rgba(0, 229, 255, 0.1);
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: var(--cyan);
    }

    .topbar-title {
      font-family: 'Orbitron', sans-serif;
      font-weight: 700;
      font-size: 0.95rem;
      letter-spacing: 1px;
      color: var(--cyan);
    }

    .topbar-ig {
      font-size: 0.8rem;
      color: var(--muted);
      font-weight: 500;
    }

    /* Pages */
    .page {
      display: none;
      padding: 20px 16px 40px;
      animation: fadeIn 0.35s ease;
    }

    .page.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ===== PAGE 1 - HOME ===== */
    .hero {
      text-align: center;
      padding: 30px 10px 20px;
    }

    .hero-crown {
      font-size: 2.2rem;
      margin-bottom: 8px;
      filter: drop-shadow(0 0 12px rgba(0, 229, 255, 0.6));
    }

    .hero-logo {
      font-family: 'Orbitron', sans-serif;
      font-weight: 900;
      font-size: 1.8rem;
      letter-spacing: 1px;
      line-height: 1.1;
      margin-bottom: 6px;
    }

    .hero-logo .dvn {
      color: #fff;
      text-shadow: 0 0 20px rgba(255,255,255,0.3);
    }

    .hero-logo .multi {
      color: var(--cyan);
      text-shadow: var(--glow);
    }

    .hero-sub {
      font-size: 0.75rem;
      letter-spacing: 3px;
      color: var(--muted);
      text-transform: uppercase;
      margin-bottom: 18px;
    }

    .hero-tag {
      display: inline-block;
      background: linear-gradient(90deg, var(--cyan), var(--blue));
      color: #000;
      font-weight: 700;
      font-size: 0.85rem;
      padding: 8px 20px;
      border-radius: 30px;
      letter-spacing: 1px;
      margin-bottom: 28px;
      box-shadow: 0 0 25px rgba(0, 229, 255, 0.4);
    }

    .services-grid {
      display: grid;
      gap: 14px;
      margin-top: 10px;
    }

    .service-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 18px;
      display: flex;
      align-items: center;
      gap: 16px;
      cursor: pointer;
      transition: all 0.25s;
    }

    .service-card:hover, .service-card:active {
      border-color: var(--cyan);
      box-shadow: var(--glow);
      transform: translateY(-2px);
    }

    .service-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      background: rgba(0, 229, 255, 0.12);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      flex-shrink: 0;
    }

    .service-info h3 {
      font-size: 1rem;
      font-weight: 700;
      color: var(--cyan);
      margin-bottom: 3px;
    }

    .service-info p {
      font-size: 0.8rem;
      color: var(--muted);
    }

    .ig-badge {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 28px;
      padding: 12px;
      background: rgba(0, 229, 255, 0.08);
      border-radius: 12px;
      border: 1px solid var(--border);
      font-size: 0.9rem;
      color: var(--cyan);
      font-weight: 600;
    }

    /* ===== COMMON PAGE HEADER ===== */
    .page-header {
      text-align: center;
      margin-bottom: 22px;
    }

    .page-header .icon-big {
      font-size: 2.4rem;
      margin-bottom: 10px;
      filter: drop-shadow(0 0 10px rgba(0, 229, 255, 0.5));
    }

    .page-header h1 {
      font-family: 'Orbitron', sans-serif;
      font-weight: 800;
      font-size: 1.45rem;
      color: var(--cyan);
      letter-spacing: 1px;
      text-shadow: var(--glow);
      margin-bottom: 6px;
    }

    .page-header p {
      color: var(--muted);
      font-size: 0.9rem;
    }

    /* Poster image */
    .poster-img {
      width: 100%;
      border-radius: 16px;
      border: 1px solid var(--border);
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
      margin-bottom: 20px;
      display: block;
    }

    /* Info box */
    .info-box {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px;
      margin-bottom: 18px;
    }

    .info-box h3 {
      color: var(--cyan);
      font-size: 0.95rem;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .info-box p {
      font-size: 0.88rem;
      color: var(--muted);
      line-height: 1.5;
    }

    .features {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 20px;
    }

    .feature {
      background: rgba(0, 229, 255, 0.06);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px;
      text-align: center;
      font-size: 0.82rem;
      color: var(--text);
    }

    .feature strong {
      display: block;
      color: var(--cyan);
      font-size: 0.9rem;
      margin-bottom: 2px;
    }

    /* ===== CONTACT PAGE ===== */
    .contact-buttons {
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-top: 10px;
    }

    .btn-contact {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      padding: 16px 20px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 1.05rem;
      text-decoration: none;
      transition: all 0.25s;
      border: none;
      cursor: pointer;
    }

    .btn-whatsapp {
      background: linear-gradient(135deg, #25D366, #128C7E);
      color: #fff;
      box-shadow: 0 6px 25px rgba(37, 211, 102, 0.35);
    }

    .btn-whatsapp:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(37, 211, 102, 0.45);
    }

    .btn-instagram {
      background: linear-gradient(135deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
      color: #fff;
      box-shadow: 0 6px 25px rgba(225, 48, 108, 0.35);
    }

    .btn-instagram:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(225, 48, 108, 0.45);
    }

    .contact-info {
      text-align: center;
      margin-top: 28px;
      padding: 18px;
      background: var(--card);
      border-radius: 14px;
      border: 1px solid var(--border);
    }

    .contact-info p {
      color: var(--muted);
      font-size: 0.9rem;
      margin-bottom: 6px;
    }

    .contact-info strong {
      color: var(--cyan);
      font-size: 1.1rem;
    }

    .payments {
      display: flex;
      justify-content: center;
      gap: 16px;
      margin-top: 18px;
      flex-wrap: wrap;
    }

    .pay-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.8rem;
      color: var(--muted);
    }

    .disclaimer {
      text-align: center;
      margin-top: 30px;
      font-size: 0.75rem;
      color: #5a6a7a;
    }

    /* Footer on every page */
    .page-footer {
      margin-top: 30px;
      text-align: center;
      padding-top: 16px;
      border-top: 1px solid var(--border);
    }

    .page-footer a {
      color: var(--cyan);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9rem;
    }

    /* Desktop */
    @media (min-width: 768px) {
      .sidebar {
        transform: translateX(0);
      }
      .overlay {
        display: none !important;
      }
      .main {
        margin-left: 260px;
      }
      .menu-btn {
        display: none;
      }
      .page {
        max-width: 680px;
        margin: 0 auto;
      }
    }
  </style>
</head>
